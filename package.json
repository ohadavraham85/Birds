{
  "name": "electric-assets-map",
  "version": "1.0.0",
  "description": "ניהול נכסי חשמל — PWA offline-first למיפוי וניהול נכסי חשמל (עמודים, שנאים, לוחות, מוני חשמל וקווים) עם יומן תחזוקה",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8788",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^4.10.38",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-window": "^7.3.0"
  }
}
